# SentinelOps - Environment Variables
# Copy this file to .env and fill in your values.

# Server (Node.js / Express)
PORT=4000
NODE_ENV=development

# MongoDB - use localhost if running MongoDB Compass locally
MONGO_URI=mongodb://localhost:27017/sentinelops

# JWT Secrets - generate strong random strings (min 32 chars)
JWT_SECRET=CHANGE_ME_sentinelops_jwt_secret_at_least_32_characters
JWT_REFRESH_SECRET=CHANGE_ME_sentinelops_refresh_secret_at_least_32_chars

# Token expiry
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend origin for CORS
CLIENT_URL=http://localhost:5173
# Optional extra origins, comma-separated
# CLIENT_URLS=http://localhost:5173,http://localhost:5174
CLIENT_URLS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.8:5173

# ML microservice URL
ML_SERVICE_URL=http://localhost:8000
VITE_ML_SERVICE_URL=http://localhost:8000

# Optional deployment modes
OFFLINE_MODE=true
NO_CLOUD_MODE=true
VITE_API_BASE_URL=http://localhost:4000
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
SYNC_LOCAL_TOKEN=CHANGE_ME_INTERNAL_SYNC_TOKEN_SECURE

# Upload config
MAX_UPLOAD_SIZE_GB=1
# Legacy fallback if you prefer megabytes instead
# MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIR=./uploads

# ML Service (Python / FastAPI)
ML_PORT=8000
MODEL_SAVE_PATH=./data/saved_models
ML_MONGO_URI=mongodb://localhost:27017/sentinelops

# ML Memory Controls (important for free-tier hosting with 512 MB RAM limit)
# Max rows per uploaded CSV — larger files are silently truncated
ML_MAX_ROWS=20000
# Max trained models held in RAM at once (older ones are evicted)
ML_MAX_MODELS_IN_RAM=2
# Prediction batch size (rows processed per chunk)
ML_PREDICT_BATCH_SIZE=5000

# ── Production hosting (fill these in on Render / Railway) ────────────────────
# NODE_ENV=production
# MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/regiment
# ML_MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/regiment
# JWT_SECRET=<long-random-string>
# JWT_REFRESH_SECRET=<long-random-string>
# CLIENT_URLS=https://your-frontend.vercel.app
# ML_SERVICE_URL=https://your-ml-service.onrender.com
# VITE_API_BASE_URL=https://your-backend.onrender.com
# VITE_ML_SERVICE_URL=https://your-ml-service.onrender.com
# COOKIE_SAME_SITE=none
# COOKIE_SECURE=true
